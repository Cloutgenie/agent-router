# Task Dropoff - environment variables
#
# The app runs completely in Demo Mode with zero configuration: every
# provider below is optional. Setting ENABLE_LIVE_PROVIDERS=true plus any
# subset of the credentials below switches matching capabilities to Live
# Mode - providers without credentials keep using their mock fallback
# automatically (see lib/providers/registry.ts).

# Master switch. Demo Mode (false/unset) never reads any of the keys below.
ENABLE_LIVE_PROVIDERS=false

# --- Tavily (live web search) ---
# Powers company discovery, funding/hiring/AI signal research, and general
# evidence gathering - see lib/providers/adapters/tavilyProvider.ts.
TAVILY_API_KEY=

# --- Apollo (decision-maker discovery + contact enrichment) ---
# Real integration - see lib/providers/adapters/apolloProvider.ts. Searches
# for a likely security decision-maker by title; only reveals full contact
# details (a separate, credit-consuming Apollo call) when a step's
# `deepEnrichment` context flag is set. Never invents an email - missing
# stays null.
APOLLO_API_KEY=

# --- Clay (enrichment waterfall) ---
CLAY_API_KEY=

# --- LLM analysis providers (interpretation only - never a substitute for
# evidence gathering; each one only reasons over evidence the other
# providers already retrieved, and shares one evidence-only schema/repair
# contract - see lib/providers/llm/evidenceOnlyAnalysis.ts). Configure any
# subset; the router picks among whichever are configured using the same
# transparent scoring it uses for every other capability. ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Browser execution (read-only: GET requests / page navigations against
# a company's own pages only - never submits forms, logs in, or performs any
# write action). See lib/providers/adapters/browserExecutor.ts. With
# ENABLE_BROWSER_EXECUTION=true alone, uses a lightweight static-fetch page
# reader. Also setting BROWSERBASE_API_KEY + BROWSERBASE_PROJECT_ID upgrades
# to a real Browserbase session driven over CDP via puppeteer-core, for
# JS-rendered careers pages the static path can't read. Note: Browserbase
# rate-limits session *creation* per project (observed: 5/minute burst limit
# on a real project) - a company hitting that limit is simply skipped for
# that run, not retried.
ENABLE_BROWSER_EXECUTION=false
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
MAX_BROWSER_PAGES_PER_TASK=10

# --- Persistent agent workers (spec #9) - persistent browser/computer-use/
# terminal workers. No specific vendor has a settled programmatic contract
# wired here yet - this only documents the shape a future integration would
# need. See lib/providers/adapters/persistentAgentExecutor.ts: even with
# both set, the adapter is an honest shell that throws rather than
# pretending to be connected. Demo Mode's MockPersistentAgentExecutor
# exercises the full lifecycle with zero credentials regardless. ---
ENABLE_PERSISTENT_AGENTS=false
PERSISTENT_AGENT_API_URL=
PERSISTENT_AGENT_API_KEY=

# --- Generic protocol adapters ---
# MCP_SERVER_URL must speak the MCP "Streamable HTTP" JSON-RPC transport -
# see lib/providers/mcp/client.ts. MCP_GRANTED_SCOPES is a comma-separated
# allowlist of write/send scopes (crm.write, email.send, calendar.write,
# files.write) the router is permitted to invoke; everything else stays
# read-only by default - see lib/providers/adapters/mcpProvider.ts.
MCP_SERVER_URL=
MCP_SERVER_NAME=
MCP_GRANTED_SCOPES=
A2A_REGISTRY_URL=
REST_PROVIDER_URL=

# --- Router tuning (optional) ---
# Fraction of routing decisions (0-1) that deliberately try the runner-up
# provider instead of the top scorer, to keep gathering real performance
# data on providers that would otherwise never get picked.
EXPLORATION_RATE=0.1
DEFAULT_EXECUTION_TIMEOUT_MS=30000

# --- Billing (lib/billing/). Single-tenant scaffold: this app has no
# user/auth system, so there is exactly one BillingAccount
# (lib/billing/account.ts). Only live-mode task execution is ever billed -
# Demo Mode is always free, no billing account involved at all. ---
# Plan a fresh account starts on: free | starter | pro | business | enterprise.
# Defaults to "pro" (not "free") so existing live-testing keeps working with
# no extra setup - there's no Checkout yet to actually buy a plan.
BILLING_DEFAULT_PLAN=pro

# --- Stripe (lib/billing/stripe/) - subscriptions, Checkout, the Billing
# Portal, and webhooks. UNVERIFIED against a real Stripe account as of this
# writing (see lib/billing/stripe/client.ts's doc comment) - written from
# the documented API shape and covered by mocked-SDK unit tests, but no
# call has ever actually run against Stripe. Every field below is required
# for the corresponding feature to work; anything unset just makes that one
# feature return a clear "not configured" error rather than breaking the
# app. Use Stripe TEST MODE keys (sk_test_.../pk_test_...) - never live
# keys - for local development. ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# From `stripe listen --forward-to localhost:3000/api/webhooks/stripe` for
# local development (prints a temporary whsec_... each run), or the
# signing secret of a configured webhook endpoint in the Stripe Dashboard.
STRIPE_WEBHOOK_SECRET=

# Price ids (not product ids) for each plan's monthly subscription price -
# create these in the Stripe Dashboard (or via the API) first.
STRIPE_STARTER_PRICE_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_BUSINESS_PRICE_ID=
# Reserved for a future metered-billing price (overage beyond included
# execution) attached to the subscription at Checkout - not read by any
# code yet; that's a separate step from reporting usage below.
STRIPE_EXECUTION_USAGE_PRICE_ID=

# The `event_name` of a Stripe Billing Meter (create one in the Dashboard
# or via the API first) - lib/billing/stripe/usageReporting.ts reports
# each task's overage as a meter event once this is set, in cents. The
# meter's Price must be configured to charge per-cent-unit for the billed
# amount to come out right. Unset = overage reporting silently no-ops
# (the local ledger still tracks overage regardless).
STRIPE_EXECUTION_METER_EVENT_NAME=

# Used to build Checkout/Portal success, cancel, and return URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000
